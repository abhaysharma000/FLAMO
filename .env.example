# ==============================================================================
# FLAMO Environment Configuration Template
# Copy this file to .env and configure your private parameters.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & Embedding Engine Configuration
# ------------------------------------------------------------------------------
# Primary Google Gemini API key. Alternatively, GOOGLE_API_KEY is supported.
# GEMINI_API_KEY takes precedence if both are set.
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_gemini_api_key_here

# Generative model used by the supervisor, planner, research, and evaluation agents.
# Defaults to gemini-3.5-flash-lite if not specified.
GEMINI_MODEL=gemini-3.5-flash-lite

# Memory backend: "sqlite" (default deterministic) or "chroma" (semantic vector store)
MEMORY_BACKEND=sqlite

# Embedding model used when MEMORY_BACKEND=chroma
EMBEDDING_MODEL=gemini-embedding-001

# ChromaDB persistence directory (must be writable by the application user)
CHROMA_PERSIST_DIRECTORY=./chroma_db

# ------------------------------------------------------------------------------
# 2. Network & Server Deployment
# ------------------------------------------------------------------------------
# Bind interface:
# Use 127.0.0.1 for local developer workstation (safe loopback development mode).
# Use 0.0.0.0 for Docker containers or remote deployment.
# IMPORTANT: When HOST is set to 0.0.0.0, AUTH_ENABLED must be true and SECRET_KEY
# must be configured, otherwise the application will fail closed at startup.
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 3. Single-Operator Authentication & Access Control
# ------------------------------------------------------------------------------
# Enable single-operator authentication. Required for remote / container exposure.
# Set to false only for private local loopback testing.
AUTH_ENABLED=true

# Operator username for dashboard authentication
OPERATOR_USERNAME=admin

# Password configuration (choose one of the two):
# Option A (Recommended): Pre-hashed password using PBKDF2-HMAC-SHA256
# Generate via: python -c "from app.services.auth_service import hash_password; print(hash_password('your_secret'))"
# OPERATOR_PASSWORD_HASH=pbkdf2:sha256:600000$salt$hash

# Option B: Plaintext password (will be safely hashed in memory at startup)
OPERATOR_PASSWORD=change_this_to_a_secure_password_in_production

# Secret key used for signing session tokens and CSRF validation
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_32_byte_secret_key_in_production

# Session duration in minutes (default 8 hours = 480 min)
SESSION_EXPIRE_MINUTES=480

# Cookie security attributes:
# Set COOKIE_SECURE=true when deployed behind HTTPS / TLS termination reverse proxy.
# Set COOKIE_SECURE=false for local plain HTTP development.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Bounded login rate limiting (max failed attempts within time window per IP)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ------------------------------------------------------------------------------
# 4. Storage & Persistence
# ------------------------------------------------------------------------------
# SQLite persistence database URL (SQLite default)
DATABASE_URL=sqlite:///./flamo.db

# Persistent directory for generated reports, research artifacts, and evidence logs
WORKSPACE_DIR=./workspace

# ------------------------------------------------------------------------------
# 5. Security & CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for cross-origin requests.
# Wildcard '*' is strictly prohibited when credentials (cookies) are permitted.
# Example: http://localhost:5173,http://localhost:8000,https://flamo.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 6. Observability & Agent Parameters
# ------------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum agent execution retries before failure recovery
MAX_RETRIES=3

# Sandbox tool timeout in seconds
TOOL_TIMEOUT_SECONDS=30
